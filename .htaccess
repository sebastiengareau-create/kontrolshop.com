# Hébergement WHC (Apache, cPanel) — www.kontrolshop.com
# HTTPS obligatoire et adresse avec « www » (certificat gratuit AutoSSL de cPanel).
RewriteEngine On
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^kontrolshop\.com$ [NC]
RewriteRule ^ https://www.kontrolshop.com%{REQUEST_URI} [L,R=301]

# Page d'erreur pour les adresses qui n'existent pas (statut 404 gardé)
ErrorDocument 404 /404.html

AddType image/webp .webp
AddType image/svg+xml .svg

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  # Style : redemandé souvent ; le lien porte aussi une version (?v=…)
  ExpiresByType text/css "access plus 1 hours"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml text/xml application/xml text/plain
</IfModule>

# Fichier de suivi de la publication (GitHub Actions) : pas public
<Files ".ftp-deploy-sync-state.json">
  Require all denied
</Files>
